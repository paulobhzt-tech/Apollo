# Copie para .env SOMENTE na VPS. Nao salve senhas no GitHub.
# Aponte o registro DNS A deste dominio para o IP publico da VPS.
APOLLO_DOMAIN=pdv.seu-dominio.com.br

# Escolha credenciais fortes e exclusivas. Nao use valores desta amostra.
MONGO_USER=apollo_admin
MONGO_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
# URI: codifique caracteres especiais da senha (%40 para @, %23 para #, etc.).
MONGO_URL=mongodb://apollo_admin:SUBSTITUA_POR_SENHA_FORTE@mongo:27017/apollo_pdv?authSource=admin

WEBHOOK_CRON_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO
