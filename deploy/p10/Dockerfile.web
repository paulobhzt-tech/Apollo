# P10: exclusively the browser Web entry; does not replace the existing Dockerfile.
FROM node:22-bookworm-slim AS web-build
WORKDIR /src/frontend
COPY frontend/package.json ./
RUN corepack enable && yarn install --non-interactive
COPY frontend/ ./
RUN yarn exec vite build --config vite.web.config.ts && test -s dist-web/index.html

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SERVE_FRONTEND_DIR=/app/web
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/backend/requirements.txt --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/
COPY backend/ /app/backend/
COPY --from=web-build /src/frontend/dist-web/ /app/web/
WORKDIR /app/backend
EXPOSE 10000
# Never include real credentials in the image. MONGO_URL and DB_NAME are supplied at runtime.
CMD ["sh", "-c", "exec uvicorn server:app --host 0.0.0.0 --port ${PORT:-10000}"]
