# P10: exclusively the browser Web entry; does not replace the existing Dockerfile.
FROM node:24-bookworm-slim AS web-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit
COPY frontend/ ./
RUN npx tsc -b --noEmit && npx vite build --config vite.web.config.ts && test -s dist-web/index.html

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SERVE_FRONTEND_DIR=/app/web APOLLO_ENV=homologation
WORKDIR /app
COPY deploy/p10/requirements.web.txt /app/requirements.web.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.web.txt && useradd --uid 10001 --no-create-home apollo
COPY backend/ /app/backend/
COPY --from=web-build /src/frontend/dist-web/ /app/web/
WORKDIR /app/backend
USER 10001:10001
EXPOSE 10000
# Never include real credentials in the image. MONGO_URL and DB_NAME are supplied at runtime.
CMD ["python", "tools/p10_environment.py", "serve"]
