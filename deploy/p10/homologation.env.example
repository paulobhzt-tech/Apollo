# P10 only. Never use real data, production URI or external provider credentials.
APOLLO_ENV=homologation
APOLLO_DEMO_MODE=true
APOLLO_HOMOLOGATION_ACK=SYNTHETIC_ONLY_NO_REAL_DATA
APOLLO_EXTERNAL_INTEGRATIONS=disabled
DB_NAME=apollo_p10_homolog
MONGO_URL_FILE=/run/secrets/mongo_uri
APOLLO_BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap_token
APP_URL=https://homolog.apollo-pdv.com
COOKIE_SECURE=true
CORS_ORIGINS=
SERVE_FRONTEND_DIR=/app/web
TRUSTED_PROXY_IPS=127.0.0.1
PORT=10000
