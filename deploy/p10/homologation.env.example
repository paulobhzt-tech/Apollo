# P10 EXAMPLE ONLY — do not commit any .env with real secrets.
APOLLO_DEMO_MODE=true
DB_NAME=apollo_p10_homolog
# Obtain only from an isolated MongoDB Atlas/test replica set. Inject as a secret:
MONGO_URL=<SECRET_FROM_RUNTIME>
APP_URL=https://homolog.apollo-pdv.com
COOKIE_SECURE=true
CORS_ORIGINS=
SERVE_FRONTEND_DIR=/app/web
# External integrations (payments, fiscal, webhooks, Drive) must be individually audited
# and blocked at network and application layers before any public exposure.
